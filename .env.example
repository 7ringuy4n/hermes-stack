# assistant â€” host .env template
#
# First setup (clean OS):
#   1) cp .env.example .env
#   2) Fill every CHANGE_ME_* value (or: python3 scripts/temp/generate_env_secrets.py)
#   3) bash run.sh up                    # core stack only
#   4) bash run.sh install <worker…>     # see docs/00-workers.md · bash run.sh install list
#   5) Zalo: bash scripts/main/setup-zalo.sh then bash scripts/main/login-zalo.sh (QR manual)
#
# Non-secret defaults explained in docs/config/DEFAULTS.md
# Workers explained in docs/00-workers.md

# =============================================================================
# A) FIRST-SETUP SECRETS â€” replace before first `run.sh up`
# =============================================================================
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME_HERMES
HERMES_DASHBOARD_SECRET=CHANGE_ME_HERMES_SECRET
API_SERVER_KEY=CHANGE_ME_API_SERVER
GATEWAY_API_KEYS=CHANGE_ME_GATEWAY_KEY
MEMORY_DB_USER=hermes
MEMORY_DB_PASSWORD=CHANGE_ME_MEMORY_DB
MEMORY_DB_NAME=hermes_memory
ZALO_API_TOKEN=CHANGE_ME_ZALO_API
# Legacy alias still accepted:
# ADMIN_API_TOKEN=CHANGE_ME_ZALO_API
OPENBAO_DEV_ROOT_TOKEN=CHANGE_ME_OPENBAO
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
# OmniRouter UI password (empty = reuse N9ROUTER_INITIAL_PASSWORD if set)
OMNIROUTER_INITIAL_PASSWORD=CHANGE_ME_OMNI
# Optional 9Router (only when ENABLE_9ROUTER=1)
N9ROUTER_INITIAL_PASSWORD=CHANGE_ME_9ROUTER
# Filled by first-setup scripts from Default Key â€” leave empty on first deploy
OMNIROUTER_API_KEY=
N9ROUTER_API_KEY=

# Optional provider keys (Media|File worker / image backends)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Qwen/Ollama are NOT used by default first-setup.
# Default: Omni combos hermes+classifier filled with OpenCode oc/*.
# Lab only: scripts/main/lab-enable-qwen-local.sh (sets ENABLE_QWEN=1).
# first-setup-omnirouter clears ENABLE_QWEN/OLLAMA_* again on each run (OpenCode default).
ENABLE_QWEN=0
# Qwen / DashScope (Omni provider id: alibaba; connection name: qwen)
QWEN_API_KEY=
# Optional model-router last-hop only when set (leave blank for OpenCode combos).
OLLAMA_BASE_URL=
# Lab example when ENABLE_QWEN=1: qwen3.5:2b-instruct
OLLAMA_MODEL=
# Extended-thinking passthrough is automatic when ENABLE_QWEN=1 (Qwen3 / cloud).
# qwen2.5 on Ollama still strips thinking at runtime (model rejects the field).
# Set explicitly only to force on when ENABLE_QWEN=0:
# ENABLE_QWEN_THINKING=1
# ALIBABA_API_KEY=
# DASHSCOPE_API_KEY=
FAL_KEY=
FLUXAI_API_KEY=
POLLINATIONS_API_KEY=
TELEGRAM_BOT_TOKEN=

# =============================================================================
# B) HOST PATHS + TIMEZONE
# =============================================================================
DEPLOY_MODE=local
DOMAIN=localhost
TZ=Asia/Ho_Chi_Minh
STACK_ROOT=/opt/assistant
ASSISTANT_DATA_DIR=/data/assistant
HERMES_DATA_DIR=/data/assistant
BACKUP_DIR=/data/assistant/backups

# =============================================================================
# C) ROUTERS â€” OmniRouter default; 9Router optional
# =============================================================================
ENABLE_OMNIROUTER=1
ENABLE_9ROUTER=0
OMNIROUTER_ENABLE_MEMORY=1
OMNIROUTER_IMAGE=diegosouzapw/omniroute:latest
OMNIROUTER_HOST_PORT=20129
# Bind Omni publish address: 127.0.0.1 (safe default) or 0.0.0.0 only when
# firewall/VPN restricts access (OpenVPN admin UI from Windows/macOS/Linux).
OMNIROUTER_BIND=127.0.0.1
# Disable Omni background credential/connection health tests.
OMNIROUTE_DISABLE_CREDENTIAL_HEALTH_CHECK=true
# Lab-only Qwen provider slim (ignored by default OpenCode first-setup).
OMNIROUTER_QWEN_ONLY_PROVIDERS=0
# Dedicated small-Qwen combo name (1.5B/1.7B-class when catalog has them).
OMNIROUTER_QWEN_FAST_COMBO=qwen-fast
# Combo aliases (not vendor model ids). first-setup-omnirouter.py creates
# ``hermes`` + ``classifier`` filled with OpenCode oc/* by first-setup-omnirouter.
OMNIROUTER_DEFAULT_COMBO=hermes
# After a paid/blocked Omni model (403 subscription), Router Worker retries these.
# Local Qwen lab: leave empty (auto/best-free cannot tool-call; adds 400 noise).
OMNIROUTER_FAILOVER_MODELS=auto/best-free
# Retry primary combo so Omni round-robin can land on an alive free member.
# Local Qwen lab: use 1–2 (inactive cloud members repeat the same 503).
OMNIROUTER_ROTATE_ATTEMPTS=5
# Sleep between hops when Omni returns capacity-busy / retry-shortly.
OMNIROUTER_BUSY_BACKOFF_S=3
# Free Omni members can be slow — wait before rotating to the next hop.
MODEL_ROUTER_TIMEOUT_S=180
OMNIROUTER_CLASSIFY_COMBO=classifier
OMNIROUTER_COMBO_STRATEGY=round-robin
N9ROUTER_DEFAULT_COMBO=hermes
# Hermes Agent default must equal the chat combo alias above (still the OpenAI "model" field).
HERMES_DEFAULT_MODEL=hermes
N9ROUTER_COMBO_STRATEGY=round-robin
N9ROUTER_COMBO_STICKY_LIMIT=1
WEB_SEARCH_MAX_RESULTS=3

# =============================================================================
# D) OPTIONAL WORKERS — use run.sh install (not listed here)
# =============================================================================
# All workers start inactive. Install by short name (backup+verify, then up):
#
#   bash run.sh install list
#   bash run.sh install schedule media security notify message monitor
#   bash run.sh install openbao zalo traefik gateway openvpn clouddrive antivirus
#
# Per-worker guide: docs/00-workers.md
# Name catalog:     scripts/main/install-component.sh
# Deactivate:       bash run.sh uninstall zalo
#
# Turn Traefik/Gateway off (not add-components ENABLE_*=0):
#   bash run.sh uninstall traefik
#   bash run.sh uninstall gateway
#
# Runtime flags on a running host (use --update):
#   bash run.sh add-components ZALO_INBOUND_QUEUE=0 --update
#   bash run.sh add-components ENABLE_9ROUTER=1 --update

# =============================================================================
# E) MEDIA / SEARCH / IMAGE (Media|File worker — bash run.sh install media)
# =============================================================================
WEB_BACKENDS=omni
# Omni Search provider cascade (explicit provider= on each /v1/search hop).
OMNIROUTER_SEARCH_PROVIDERS=tavily-search,firecrawl-search,searxng-search
# Cap each provider so failover does not wait 60s+90s+…
WEB_SEARCH_PROVIDER_TIMEOUT_S=30
# Optional extract override (default from config/web-search-combo.json).
WEB_EXTRACT_BACKENDS=tavily,firecrawl
SEARXNG_PORT=8888
OCR_PORT=8091
JOBS_PORT=8104
IMAGE_BACKENDS=
# Dispatcher creates+sends txt/pdf/docx/xlsx (required for Zalo “tạo file …”).
OFFICE_FILE_GEN=1
IMAGE_LLM_PROVIDER=openai
IMAGE_LLM_API_KEY=
IMAGE_LLM_BASE_URL=
IMAGE_LLM_MODEL=dall-e-3
IMAGE_LLM_SIZE=1920x1080
VIDEO_SECONDS_MAX=120
IMAGE_VENDOR_PROVIDER=
IMAGE_VENDOR_API_KEY=
IMAGE_VENDOR_URL=
IMAGE_VENDOR_MODEL=fal-ai/flux/schnell
COMFYUI_CPU_URL=http://comfyui-cpu:8188
COMFYUI_GPU_URL=http://comfyui-gpu:8188
COMFYUI_HAS_GPU=0
COMFYUI_CPU_WORKFLOW=sdxl
COMFYUI_CPU_PORT=8188
COMFYUI_GPU_PORT=8189

# =============================================================================
# F) ZALO / MESSAGE WORKER (bash run.sh install zalo or install message)
# =============================================================================
# After install + stack up: bash scripts/main/setup-zalo.sh (QR first — deploy user, not sudo)
# Re-login only: bash scripts/main/login-zalo.sh
ZALO_API_PORT=8100
ZALO_PLUGIN_URL=http://zalo-proxy:8787
ZALO_PLUGIN_TOKEN=
ZALO_INBOUND_QUEUE=1
ZALO_INBOUND_QUEUE_MAX=8
ZALO_INBOUND_QUEUE_TTL_S=3600
# Trace enqueue/process/turns in Postgres (zalo-api DATABASE_URL). Hydrate fallback when Valkey cold.
ZALO_HISTORY_POSTGRES=1
# Hung Hermes/web-search turn must release so the next message still answers.
ZALO_QUEUE_TURN_TIMEOUT_S=300
ZALO_QUEUE_DRAIN_MAX_S=600
ZALO_GROUP_MODE=mention
ZALO_ADMIN_USERS=
NOTIFY_ZALO_THREAD=
NOTIFY_PORT=8092
HERMES_WORKFLOW=1
ZALO_WORKFLOW=1
WORKFLOW_PORT=8108
HERMES_WORKFLOW_TIMEOUT_S=90
HERMES_WORKFLOW_WAIT_S=20
ZALO_WORKFLOW_TURN_TIMEOUT_S=420
# Parallel workflow jobs per Zalo turn. Default 8 targets ~5–10 concurrent
# multi-request users (see docs/QWEN_PERFORMANCE.md sizing table).
ZALO_WORKFLOW_PARALLEL=8
MODEL_ROUTER_CLASSIFY_TIMEOUT_S=5
MODEL_ROUTER_OUTBOUND_TIMEOUT_S=30
# Classify uses Omni combo ``classifier`` (OpenCode cloud from first-setup).
# Outbound uses chat combo ``hermes``.
MODEL_ROUTER_CLASSIFY_MODEL=classifier
MODEL_ROUTER_OUTBOUND_MODEL=hermes
SESSION_MAX_MESSAGES=16

# =============================================================================
# G) EDGE / GATEWAY / TRAEFIK
# =============================================================================
TRAEFIK_MODE=local
TRAEFIK_HOST_PORT=8080
TRAEFIK_BIND=127.0.0.1
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_ACME_ENABLED=0
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_ACME_DOMAIN=assistant.example.com
GATEWAY_HOST_PORT=8088
GATEWAY_UPSTREAM_URL=http://traefik:80
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_S=60
GATEWAY_SKIP_RL_PATHS=/coding,/v1/coding,/skills/coding,/schedule,/v1/schedule,/skills/schedule,/v1/schedules
GATEWAY_PROXY_TIMEOUT_S=120
GATEWAY_REQUIRE_AUTH=1
GATEWAY_AUTH_ENABLED=1
GATEWAY_TRUST_FORWARDED=0
GATEWAY_RL_FAIL_CLOSED=1
OPENVPN_HOST_PORT=1194
OPENVPN_DATA_DIR=/data/assistant/openvpn

# =============================================================================
# H) SECURITY / MONITOR / OPENBAO (when workers active)
# =============================================================================
OPENBAO_PORT=8200
OPENBAO_ADDR=http://127.0.0.1:8200
GRAFANA_HOST_PORT=23000
SECURITY_YARA=1
SECURITY_SANDBOX=0
SECURITY_LLM_JUDGE=0
ENABLE_LLM_JUDGE=0
SECURITY_FAIL_CLOSED=1
AV_GATEWAY_PORT=8098
CLAMAV_PORT=3310
CLOUDDRIVE_MIRROR_DIR=/data/clouddrive
CLOUDDRIVE_REMOTE=clouddrive:
CLOUDDRIVE_DOCS_PATH=assistant/docs
RCLONE_CONFIG_DIR=/root/.config/rclone
