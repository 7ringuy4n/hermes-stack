# assistant — secrets only (CHANGE THESE FIRST)
#
# 1) cp .env.example .env
# 2) Replace every CHANGE_ME value before first deploy
# Non-secret defaults: docs/config/DEFAULTS.md

ASSISTANT_PROFILE=low          # profiles: low|medium|high
DEPLOY_MODE=local              # modes: local|remote (ops / backup paths)
DOMAIN=localhost
TZ=Asia/Ho_Chi_Minh            # IANA timezone, e.g. Asia/Ho_Chi_Minh|UTC

STACK_ROOT=/opt/assistant
ASSISTANT_DATA_DIR=/data/assistant
HERMES_DATA_DIR=/data/assistant
BACKUP_DIR=/data/assistant/backups

# --- Secrets (required) ---
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME_HERMES
HERMES_DASHBOARD_SECRET=CHANGE_ME_HERMES_SECRET

N9ROUTER_INITIAL_PASSWORD=CHANGE_ME_9ROUTER
# Leave empty on first deploy — scripts/main/first-setup-9router-hermes.py copies 9Router "Default Key"
N9ROUTER_API_KEY=
# Default combo = OpenCode Free (oc/*); Hermes uses this as model id
N9ROUTER_DEFAULT_COMBO=hermes
HERMES_DEFAULT_MODEL=hermes    # usually same as N9ROUTER_DEFAULT_COMBO
# Combo routing across oc/* models
N9ROUTER_COMBO_STRATEGY=round-robin   # strategies: round-robin|fallback|fusion|rotate
N9ROUTER_COMBO_STICKY_LIMIT=1         # 1 = rotate each request; >1 sticks N turns

MEMORY_DB_USER=hermes
MEMORY_DB_PASSWORD=CHANGE_ME_MEMORY_DB
MEMORY_DB_NAME=hermes_memory

# Optional Medium+ web search (empty keys = that backend skipped)
# On Medium/High, profile.sh defaults WEB_BACKENDS=tavily,firecrawl if unset
WEB_BACKENDS=                  # low: empty | medium+: tavily,firecrawl
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SEARXNG_PORT=8888
OCR_PORT=8091
JOBS_PORT=8104

# Medium+ image gen — POST /v1/image fallback order
# llm (OpenAI/Gemini/DeepSeek) → vendor (fal/pollinations/fluxai/…) → ComfyUI CPU → GPU
IMAGE_BACKENDS=                # low: forced empty | medium+/high: e.g. vendor,comfy-cpu
# llm slot — IMAGE_LLM_PROVIDER: openai | gemini | deepseek | custom
IMAGE_LLM_PROVIDER=openai
IMAGE_LLM_API_KEY=             # or OPENAI_API_KEY / GEMINI_API_KEY / DEEPSEEK_API_KEY
IMAGE_LLM_BASE_URL=            # empty = provider preset (openai/gemini/deepseek)
IMAGE_LLM_MODEL=dall-e-3       # gemini: imagen-3.0-generate-002 · deepseek: set when available
IMAGE_LLM_SIZE=1024x1024
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# vendor slot — IMAGE_VENDOR_PROVIDER: fal | pollinations | fluxai | openai | http
IMAGE_VENDOR_PROVIDER=pollinations
IMAGE_VENDOR_API_KEY=          # or FAL_KEY / FLUXAI_API_KEY / POLLINATIONS_API_KEY
IMAGE_VENDOR_URL=              # required for fluxai|http
IMAGE_VENDOR_MODEL=fal-ai/flux/schnell
FAL_KEY=
FLUXAI_API_KEY=
POLLINATIONS_API_KEY=
POLLINATIONS_URL=https://image.pollinations.ai/prompt
# Legacy aliases (still accepted by dispatcher): IMAGE_PAID1_* → llm, IMAGE_PAID2_* → vendor
COMFYUI_CPU_URL=http://comfyui-cpu:8188
COMFYUI_GPU_URL=http://comfyui-gpu:8188
COMFYUI_HAS_GPU=0              # 1 = start comfyui-gpu + use FLUX.2 klein path
COMFYUI_CPU_WORKFLOW=sdxl      # sdxl | sd15
COMFYUI_CPU_PORT=8188
COMFYUI_GPU_PORT=8189

# --- High (ASSISTANT_PROFILE=high) ---
# .env = profile/paths + OpenBao bootstrap + Compose interpolate
# After first-setup-openbao, API keys SoT = OpenBao UI :8200 (also exported to $ASSISTANT_DATA_DIR/.env.openbao)
OPENBAO_DEV_ROOT_TOKEN=CHANGE_ME_OPENBAO
OPENBAO_PORT=8200
OPENBAO_ADDR=http://127.0.0.1:8200

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
GRAFANA_HOST_PORT=23000

ADMIN_API_TOKEN=CHANGE_ME_ADMIN_API

# Notify OFF by default on High — set ENABLE_NOTIFY=1 to start notify + alert-watch
ENABLE_NOTIFY=0
NOTIFY_ZALO_THREAD=
NOTIFY_PORT=8092

# ClamAV / av-gateway OFF by default on High — set ENABLE_ANTIVIRUS=1 when AV scan is required
ENABLE_ANTIVIRUS=0
AV_GATEWAY_PORT=8098
CLAMAV_PORT=3310

# CloudDrive mirror — set ENABLE_CLOUDDRIVE=1 when rclone config exists on host
ENABLE_CLOUDDRIVE=0
CLOUDDRIVE_MIRROR_DIR=/data/clouddrive
CLOUDDRIVE_REMOTE=clouddrive:
CLOUDDRIVE_DOCS_PATH=assistant/docs
RCLONE_CONFIG_DIR=/root/.config/rclone

# Optional channel (empty = unused)
# Zalo: ENABLE_ZALO=1 → after stack healthy, setup-zalo installs bridge (no QR).
# Manual last step: bash scripts/main/login-zalo.sh
# Upstream: hermes-zalo-plugin by Cường Tuấn Nguyễn (cuongdev) — MIT
ENABLE_ZALO=0
ZALO_PLUGIN_URL=http://zalo-proxy:8787
ZALO_GROUP_MODE=mention
ZALO_ADMIN_USERS=              # optional bootstrap; runtime sole admin is zalo_admin_users.txt
# After login-zalo: bridge ownId is seeded as first admin; then !zalo claim / !zalo admin transfer
ZALO_PLUGIN_TOKEN=
TELEGRAM_BOT_TOKEN=

# Edge — VPN/LAN only (default OFF). See docs/05-edge-networking.md
# Zalo stays on host bridge → zalo-proxy → Hermes (does not use API Gateway).
ENABLE_TRAEFIK=0
ENABLE_API_GATEWAY=0
ENABLE_OPENVPN=0
TRAEFIK_HOST_PORT=8080
GATEWAY_HOST_PORT=8088
GATEWAY_UPSTREAM_URL=http://hermes:8642
# When ENABLE_TRAEFIK=1 prefer: GATEWAY_UPSTREAM_URL=http://traefik:80
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_S=60
GATEWAY_SKIP_RL_PATHS=/coding,/v1/coding,/skills/coding
GATEWAY_PROXY_TIMEOUT_S=120
OPENVPN_HOST_PORT=1194
OPENVPN_DATA_DIR=/data/assistant/openvpn

# Let's Encrypt (optional). HTTP-01 needs public 80/443 — keep disabled for VPN/LAN-only.
TRAEFIK_ACME_ENABLED=0
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_ACME_DOMAIN=assistant.example.com
# TRAEFIK_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TRAEFIK_BIND=127.0.0.1
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
