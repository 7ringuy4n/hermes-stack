# Dynamic routes — Hermes with Let's Encrypt (Host + TLS)
# Copied/activated when TRAEFIK_ACME_ENABLED=1 (see compose / Apply script).
# Host rule must match TRAEFIK_ACME_DOMAIN.

http:
  routers:
    zalo-bridge:
      rule: "PathPrefix(`/zalo-bridge`)"
      entryPoints:
        - zalo-internal
      service: zalo-bridge
      middlewares:
        - zalo-strip-prefix
      priority: 100

    hermes-gw-http:
      rule: "Host(`CHANGE_ME_DOMAIN`)"
      entryPoints:
        - web
      middlewares:
        - redirect-https
      service: hermes-gw
      priority: 1

    hermes-gw:
      rule: "Host(`CHANGE_ME_DOMAIN`)"
      entryPoints:
        - websecure
      service: hermes-gw
      tls:
        certResolver: letsencrypt
      priority: 1

  middlewares:
    zalo-strip-prefix:
      stripPrefix:
        prefixes:
          - "/zalo-bridge"

    redirect-https:
      redirectScheme:
        scheme: https
        permanent: true

  services:
    zalo-bridge:
      loadBalancer:
        servers:
          - url: "http://zalo-proxy:8787"
        healthCheck:
          path: "/health"
          interval: "15s"
          timeout: "5s"
        passHostHeader: true

    hermes-gw:
      loadBalancer:
        servers:
          - url: "http://hermes:8642"
        healthCheck:
          path: "/"
          interval: "15s"
          timeout: "5s"
        passHostHeader: true
