# Edge networking — VPN/LAN only (default OFF). Zalo bypasses Gateway.
# See docs/05-edge-networking.md
ENABLE_TRAEFIK=0
ENABLE_API_GATEWAY=0
ENABLE_OPENVPN=0
TRAEFIK_HOST_PORT=8080
GATEWAY_HOST_PORT=8088
# When Traefik is on: http://traefik:80  |  Gateway alone: http://hermes:8642
GATEWAY_UPSTREAM_URL=http://hermes:8642
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_S=60
GATEWAY_SKIP_RL_PATHS=/coding,/v1/coding,/skills/coding
GATEWAY_PROXY_TIMEOUT_S=120
OPENVPN_HOST_PORT=1194
OPENVPN_DATA_DIR=/data/assistant/openvpn
